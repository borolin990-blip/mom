# ==========================================================================
# mom — environment configuration
# Copy this file to `.env` and fill in the values you have.
# The app runs with NO real credentials in MVP mode:
#   AI_PROVIDER=mock  +  STORAGE_PROVIDER=local
# Swap in real providers later by changing the *_PROVIDER vars + their keys.
# NEVER commit your real .env file. Keep all secrets server-side only.
# ==========================================================================

# ---- Core ----------------------------------------------------------------
NODE_ENV=development

# ---- Database (PostgreSQL) -----------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mom?schema=public

# ---- Auth (added in Phase 1.3) -------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- AI provider ---------------------------------------------------------
# "mock"   -> deterministic local generator, no API key needed (default)
# "openai" -> requires OPENAI_API_KEY
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage provider ----------------------------------------------------
# "local" -> saves uploads to disk under ./.storage (default, dev only)
# "r2"    -> Cloudflare R2 (S3-compatible), requires the R2_* vars below
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
