// mom — AI Content Operating System
// Initial database schema (Phase 0)
//
// Design principles:
//  - Multi-tenant from row one: Workspace is the tenant/billing boundary.
//  - A Workspace has many Members (users w/ roles) and many Businesses
//    (supports agencies managing several clients).
//  - Every content-bearing row is reachable from a Business, so tenant
//    isolation can be enforced at the query layer.
//  - Publishing + performance are modeled now but only exercised in Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String? // null when authenticated via OAuth only
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  members      Membership[]
  businesses   Business[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(OWNER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Billing (prepared, not enforced in Phase 1)
// ---------------------------------------------------------------------------

model Subscription {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  plan             Plan      @default(FREE)
  status           String    @default("active")
  currentPeriodEnd DateTime?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

// ---------------------------------------------------------------------------
// Business profile — feeds every AI prompt
// ---------------------------------------------------------------------------

model Business {
  id             String          @id @default(cuid())
  workspaceId    String
  name           String
  industry       String // e.g. "mortgage_consulting" (human-readable)
  // Binds the business to a Vertical module (all niche logic). "generic" is the
  // vertical-agnostic fallback; "mortgage" is the primary vertical.
  verticalKey    String  @default("generic")
  targetAudience String?
  brandTone      String? // e.g. "professional, warm, trustworthy"
  goals          String[] // ["leads","awareness","sales"]
  description    String?

  // Optional profile sources the owner can paste during onboarding. The AI uses
  // these (and everything else) to build the Business Knowledge Profile.
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  linkedinUrl  String?

  // The living Business Knowledge Profile: the AI's derived understanding
  // (services, audience, tone, pain points, writing style, CTA style, topics).
  // Structured JSON so it can grow without a migration each time it learns more.
  knowledge   Json?
  onboardedAt DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentAssets  ContentAsset[]
  socialAccounts SocialAccount[]
  posts          Post[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Content library
// ---------------------------------------------------------------------------

model ContentAsset {
  id           String             @id @default(cuid())
  businessId   String
  type         AssetType
  // Opaque key in the storage provider (never a hardcoded URL). Null for
  // idea-only posts that have no uploaded media.
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  contextNote  String? // optional user-supplied context about the content
  status       AssetStatus        @default(UPLOADED)
  analysis     Json? // AI content-analysis result
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  generations  GeneratedContent[]
  posts        Post[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([businessId])
}

enum AssetType {
  VIDEO
  IMAGE
  IDEA // a text-only post created from an idea/prompt (no uploaded media)
}

enum AssetStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  GENERATED
  FAILED
}

// ---------------------------------------------------------------------------
// AI-generated content (versioned; supports primary + alternatives)
// ---------------------------------------------------------------------------

model GeneratedContent {
  id           String       @id @default(cuid())
  assetId      String
  version      Int          @default(1)
  isPrimary    Boolean      @default(true)
  hook         String?
  caption      String?
  description  String?
  cta          String?
  hashtags     String[]
  category     String? // AI-inferred content category
  platformHint String? // suggested posting platform
  model        String? // which AI model produced this (auditability)
  raw          Json? // full structured AI output
  asset        ContentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Publishing (modeled now; integrations land in Phase 2)
// ---------------------------------------------------------------------------

model SocialAccount {
  id         String   @id @default(cuid())
  businessId String
  platform   Platform
  handle     String?
  // OAuth tokens (encrypted) added when integrations land in Phase 2
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, platform])
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  YOUTUBE
}

model Post {
  id           String        @id @default(cuid())
  businessId   String
  assetId      String?
  generationId String?
  platform     Platform
  status       PostStatus    @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  caption      String? // resolved final copy
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset        ContentAsset? @relation(fields: [assetId], references: [id])
  metrics      PostMetric[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId, scheduledFor])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------------------------
// Performance (placeholder in Phase 1; learning loop in Phase 2)
// ---------------------------------------------------------------------------

model PostMetric {
  id          String   @id @default(cuid())
  postId      String
  capturedAt  DateTime @default(now())
  impressions Int?
  likes       Int?
  comments    Int?
  shares      Int?
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}
